{
  "policies": [
    {
      "handler": {
        "export": "MockApiInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {}
      },
      "name": "mock-api-inbound",
      "policyType": "mock-api-inbound"
    },
    {
      "handler": {
        "export": "RateLimitInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "rateLimitBy": "ip",
          "requestsAllowed": 2,
          "timeWindowMinutes": 1
        }
      },
      "name": "rate-limit-inbound",
      "policyType": "rate-limit-inbound"
    },
    {
      "handler": {
        "export": "ApiKeyInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "allowUnauthenticatedRequests": false,
          "cacheTtlSeconds": 60
        }
      },
      "name": "api-key-inbound",
      "policyType": "api-key-inbound"
    },
    {
      "handler": {
        "export": "RateLimitInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "rateLimitBy": "ip",
          "requestsAllowed": 5,
          "timeWindowMinutes": 1,
          "mode": "async"
        }
      },
      "name": "rate-limit-inbound-1",
      "policyType": "rate-limit-inbound"
    },
    {
      "handler": {
        "export": "ApiKeyInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "allowUnauthenticatedRequests": false,
          "cacheTtlSeconds": 60
        }
      },
      "name": "api-key-inbound-1",
      "policyType": "api-key-inbound"
    },
    {
      "handler": {
        "export": "RateLimitInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "rateLimitBy": "function",
          "requestsAllowed": 5,
          "timeWindowMinutes": 1,
          "mode": "strict",
          "identifier": {
            "export": "dynamicRateLimit",
            "module": "$import(./modules/rate_dinamico)"
          }
        }
      },
      "name": "rate-limit-dinamico",
      "policyType": "rate-limit-inbound"
    },
    {
      "handler": {
        "name": "my-quota-inbound-policy",
        "policyType": "quota-inbound",
        "handler": {
          "export": "QuotaInboundPolicy",
          "module": "$import(@zuplo/runtime)",
          "options": {
            "period": "daily",
            "quotaBy": "user",
            "allowances": {
              "requests": 5
            },
            "quotaOnStatusCodes": "200-299"
          }
        }
      },
      "name": "quota-inbound",
      "policyType": "quota-inbound"
    }
  ]
}